{
  "name": "studentmanager_nest",
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "@nestjs/cli": "^11.0.17",
    "@nestjs/schematics": "^11.0.10",
    "@nestjs/testing": "^11.1.17",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^6.4.15",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "jest": "^30.3.0",
    "prisma": "^7.6.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.17",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.0",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0",
    "wait-on": "^9.0.5"
  },
  "scripts": {
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "start:tunnel": "cloudflared tunnel --protocol http2 run studentmanager-api",
    "start:public": "concurrently -k -n api,tunnel \"yarn start\" \"wait-on tcp:3001 && yarn start:tunnel\"",
    "start:dev:public": "concurrently -k -n api,tunnel \"yarn start:dev\" \"wait-on tcp:3001 && yarn start:tunnel\"",
    "build": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  }
}
