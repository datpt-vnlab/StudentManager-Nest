generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id             String   @id @db.Uuid
  name           String
  email          String   @unique
  otp_code       String?
  otp_expires_at DateTime?
  created_at     DateTime

  settings              AdminSetting?
  face_profiles         FaceProfile[]
  face_id_browsers      AdminFaceIdBrowser[]
}

model Student {
  id            String  @id
  password_hash String
  first_name    String
  last_name     String
  email         String  @unique
  major_id      String? @db.Uuid
  address       String?
  gender        String?
  birthday      DateTime?
  status        String
  created_at    DateTime

  major Major? @relation(fields: [major_id], references: [id], onDelete: SetNull)
}

model Major {
  id         String   @id @db.Uuid
  major_name String   @unique
  created_at DateTime

  students Student[]
}

model AdminSetting {
  id               String   @id @db.Uuid
  admin_id         String   @unique @db.Uuid
  face_id_enabled  Boolean  @default(false)
  session_timeout  Int      @default(30)
  updated_at       DateTime?

  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

model FaceProfile {
  id         String   @id @db.Uuid
  admin_id   String?  @db.Uuid
  descriptor Json
  created_at DateTime

  admin Admin? @relation(fields: [admin_id], references: [id], onDelete: Cascade)
}

model AdminFaceProfile {
  id                  String   @id @db.Uuid
  admin_id            String   @unique @db.Uuid
  embedding           Unsupported("vector")
  embedding_dimension Int      @map("embedding_dimension")
  created_at          DateTime @default(now()) @map("created_at")

  @@map("admin_face_profiles")
}

model AdminFaceIdBrowser {
  id                    String    @id @db.Uuid
  admin_id              String    @db.Uuid
  fingerprint_hash      String    @db.VarChar(64)
  browser_label         String?   @db.VarChar(160)
  user_agent            String?
  face_id_enabled       Boolean   @default(false)
  first_otp_verified_at DateTime  @default(now())
  last_otp_verified_at  DateTime  @default(now())
  last_face_login_at    DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @default(now())

  admin Admin @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@unique([admin_id, fingerprint_hash])
  @@index([admin_id])
  @@map("admin_face_id_browsers")
}
